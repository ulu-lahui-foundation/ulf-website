---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";

const tabs = [
  { label: "At a Glance", href: "/impact/" },
  { label: "By Program", href: "/impact/by-program/" },
  { label: "Stories", href: "/impact/stories/" },
];

const programs = [
  {
    name: "PLACES Education",
    hue: "p-ulu-l", head: "head-ulu-dark",
    stats: [
      { num: "K-12", label: "Standards-aligned lessons in ʻŌlelo Hawaiʻi and English" },
      { num: "Quarterly", label: "Professional development sessions" },
      { num: "3", label: "Partner school communities: Kāneʻohe, Hāna, Niʻihau" },
    ],
  },
  {
    name: "Kumu Connect",
    hue: "p-alaea-l", head: "head-alaea",
    stats: [
      { num: "36", label: "Educators in the 3-school evaluation" },
      { num: "4.20/5", label: "Cultural accuracy" },
      { num: "4.45/5", label: "Pedagogical usefulness" },
      { num: "87", label: "System Usability Scale score in the 13-educator co-design study" },
    ],
  },
  {
    name: "AI for Hawaiʻi",
    hue: "p-moana-l", head: "head-moana",
    stats: [
      { num: "33", label: "Schools reached" },
      { num: "6", label: "Complex areas" },
      { num: "97%", label: "Average increase in AI understanding, 126% among initially low-confidence participants" },
      { num: "6", label: "Workshops delivered" },
    ],
  },
];
---
<Base title="Impact by Program — Ulu Lāhui Foundation" description="Program-by-program evidence for PLACES Education, Kumu Connect, and AI for Hawaiʻi.">
  <PageHead
    eyebrow="Impact · By Program"
    title="Impact by program"
    lede="The same evidence, split per initiative, so a funder interested in one program does not have to reverse-engineer which stat belongs to which."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/impact/by-program/" />
  </div>

  {programs.map((p) => (
    <>
      <StitchedBand leftHue={p.name === "Kumu Connect" ? "lehua" : "ulu"} rightHue="kai" flip={p.name === "AI for Hawaiʻi"}>
        <div class={`${p.hue} block`} style="padding:34px 38px;">
          <div class="eyebrow" class:list={p.head}>Program outcomes</div>
          <h2 class={p.head} style="margin-top:6px;">{p.name}</h2>
          <div class="piece-row" style="margin-top:18px;">
            {p.stats.map((s) => (
              <div class="block pb p-kai-l" style="padding:20px 18px;">
                <div class="num" style="color:var(--kai); font-size:26px;">{s.num}</div>
                <div class="lbl" style="color:var(--kai);">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
      </StitchedBand>
      <div class="seam-thick"></div>
    </>
  ))}

  <div class="container-narrow" style="padding-top:8px;">
    <p style="font-size:13.5px; color:var(--muted);">
      PLACES shares figures with program documentation and the University of Hawaiʻi at Mānoa and
      Georgia Tech award team; Kumu Connect and AI for Hawaiʻi figures come from the published IDC
      2026 evaluation and the AI4HI 2026 Impact Report respectively.
    </p>
  </div>
</Base>