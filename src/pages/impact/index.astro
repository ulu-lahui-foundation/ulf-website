---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";
import { stats, confidenceGains } from "../../data/stats";

const tabs = [
  { label: "At a Glance", href: `${BASE}/impact/` },
  { label: "By Program", href: `${BASE}/impact/by-program/` },
  { label: "Stories", href: `${BASE}/impact/stories/` },
];
---
<Base title="Impact — Ulu Lāhui Foundation" description="At-a-glance outcomes from AI for Hawaiʻi, Kumu Connect, and PLACES Education.">
  <PageHead
    eyebrow="Impact"
    title="The numbers, sourced and explained"
    lede="A program officer should be able to verify every claim on this page. Where shared with our funders, the source is named."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/impact/" />
  </div>

  <StitchedBand leftHue="ulu-l" rightHue="alaea" pair={1}>
    <div class="stat-bar">
      {stats.map((s) => (
        <div class={`block p-${s.tone === "olena" ? "olena-l" : `${s.tone}-l`}`}>
          <div class="num" class:list={s.tone === "olena" ? "head-olena-dark" : s.tone === "ulu" ? "head-ulu-dark" : `head-${s.tone}`}>{s.num}</div>
          <div class="lbl" class:list={s.tone === "olena" ? "head-olena-dark" : s.tone === "ulu" ? "head-ulu-dark" : `head-${s.tone}`}>{s.label}</div>
        </div>
      ))}
    </div>
  </StitchedBand>
  <div class="container-narrow" style="margin-top:14px;">
    <p style="font-size:13px; color:var(--muted);">
      Where overlapping, these figures are sourced to the AI4HI 2026 Impact Report. Unique student
      counts are reported program-by-program pending further reconciliation.
    </p>
  </div>

  <div class="seam-thick"></div>

  <div class="table">
    <div class="content-col">
      <div class="band-label">
        <div class="eyebrow">Growth in confidence — AI4HI 2026 Impact Report</div>
        <h2 style="margin-top:8px;">Pre/post workshop gains</h2>
      </div>
      <div class="gallery">
        {confidenceGains.map((c, i) => (
          <div class={`cell patch ${i % 2 === 0 ? "p-moana-l" : "p-alaea-l"}`} style="aspect-ratio:auto; min-height:150px;">
            <div class="num" style={i % 2 === 0 ? "color:var(--moana);" : "color:var(--alaea-deep);"}>{c.change}</div>
            <div class="lbl" style={i % 2 === 0 ? "color:var(--moana);" : "color:var(--alaea-deep);"}>{c.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="seam-thin"></div>

  <StitchedBand leftHue="kai" rightHue="moana" pair={2}>
    <div class="piece-row">
      <div class="block pb p-kai-l">
        <div class="eyebrow" style="color:var(--kai);">Where the work happens</div>
        <h3 style="color:var(--kai); margin-top:8px;">Six complex areas, multiple islands</h3>
        <ul style="margin-top:12px; list-style:none;">
          <li style="margin-bottom:6px;">Kāneʻohe — Oʻahu</li>
          <li style="margin-bottom:6px;">Hāna — Maui</li>
          <li style="margin-bottom:6px;">Hilo — Hawaiʻi Island</li>
          <li style="margin-bottom:6px;">Puna — Hawaiʻi Island</li>
          <li style="margin-bottom:6px;">Plus Kaiapuni partners in Leeward Oʻahu and beyond</li>
        </ul>
      </div>
      <div class="block pb p-moana-l">
        <div class="eyebrow" style="color:var(--moana);">Funding, stated accurately</div>
        <h3 style="color:var(--moana); margin-top:8px;">Direct awards versus collaborative grants</h3>
        <p style="margin-top:10px;">
          We distinguish ULF's direct award amounts from the total value of larger collaborative
          grants ULF participates in, such as NSF Broadening Participation in Computing awards led by
          the University of Hawaiʻi at Mānoa and Georgia Tech. Those totals are never silently added
          together, because they describe different things.
        </p>
      </div>
    </div>
  </StitchedBand>

  <div class="section container-narrow">
    <div class="qb q-olena-l" style="padding:34px 40px;">
      <div class="eyebrow" style="color:var(--olena-dark);">Annual report</div>
      <h2 style="color:var(--olena-dark); margin-top:6px; font-size:22px;">Our first Annual Report is in progress</h2>
      <p style="margin-top:10px; font-size:14.5px;">
        We will publish it here the moment it is ready, with program outcomes, finances, and
        governance. Leave your email and we will send it to you directly.
      </p>
      <div class="stitch-input" style="margin-top:16px; max-width:440px;">
        <svg viewBox="0 0 200 189"><use href="#uluLeaf" class="leaf-outline" /></svg>
        <input type="email" placeholder="Your email" aria-label="Email address" />
        <a class="btn btn-primary" style="--tone:var(--olena); --tone-deep:var(--olena-deep); --tone-ink:var(--ink);" href={`${import.meta.env.BASE_URL}/news/newsletter/`}>Notify me</a>
      </div>
    </div>
  </div>
</Base>