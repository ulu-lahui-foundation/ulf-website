---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";
import { site } from "../../data/site";

const tabs = [
  { label: "News", href: `${BASE}/news/` },
  { label: "Press Releases", href: `${BASE}/news/press-releases/` },
  { label: "Media Coverage", href: `${BASE}/news/media-coverage/` },
  { label: "Newsletter", href: `${BASE}/news/newsletter/` },
];
---
<Base title="Newsletter — Ulu Lāhui Foundation" description="Sign up for field notes from Ulu Lāhui Foundation.">
  <PageHead
    eyebrow="News · Newsletter"
    title="Newsletter signup"
    lede="One email a month: program updates, research findings, and ways to get involved."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/news/newsletter/" />
  </div>

  <StitchedBand leftHue="kai" rightHue="moana" pair={3}>
    <div class="p-kai-l" style="padding:48px 46px;">
      <div class="label" style="color:var(--kai-deep);">Field notes</div>
      <h2 style="color:var(--kai); margin-top:8px; font-size:26px;">From classrooms to papers, in your inbox</h2>
      <p style="font-size:14.5px; margin:12px 0 22px; max-width:52ch;">
        Sign up now. When the first real issue ships, it goes straight to you. We do not run an empty
        archive; this page is simply the door.
      </p>
      <div class="stitch-input" style="max-width:460px;">
        <svg viewBox="0 0 200 189"><use href="#uluLeaf" class="leaf-outline" /></svg>
        <input type="email" placeholder="Your email" aria-label="Email address" />
        <a class="btn btn-primary" style="--tone:var(--kai); --tone-deep:var(--kai-deep);" href={`mailto:${site.email}?subject=Newsletter signup`}>Sign up</a>
      </div>
      <p style="font-size:12.5px; color:var(--muted); margin-top:16px;">
        Delivery tooling is being selected; your address is used only for this newsletter.
      </p>
    </div>
  </StitchedBand>
</Base>