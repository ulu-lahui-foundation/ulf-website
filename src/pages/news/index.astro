---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";

const tabs = [
  { label: "News", href: `${BASE}/news/` },
  { label: "Press Releases", href: `${BASE}/news/press-releases/` },
  { label: "Media Coverage", href: `${BASE}/news/media-coverage/` },
  { label: "Newsletter", href: `${BASE}/news/newsletter/` },
];

const items = [
  {
    title: "Kumu Connect named a flagship evaluation of 2026",
    date: "2026",
    text: "The full system and evaluation paper, with 36 educators across 3 schools, was published at IDC 2026.",
    href: `${BASE}/research/kumu-connect-rd/`,
    hue: "p-alaea", head: "text-white", subCls: "opacity:0.85;",
  },
  {
    title: "AI for Hawaiʻi reaches 33 schools",
    date: "2026",
    text: "Six workshops, six complex areas, and a 97% average increase in AI understanding among kumu.",
    href: `${BASE}/initiatives/ai-for-hawaii/`,
    hue: "p-moana-l", head: "head-moana",
  },
  {
    title: "PLACES Education earns NSF support",
    date: "2023",
    text: "The five-year award to the University of Hawaiʻi at Mānoa and Georgia Tech team includes ULF as a collaborator, supporting place-based CS at scale.",
    href: `${BASE}/news/press-releases/`,
    hue: "p-ulu-l", head: "head-ulu-dark",
  },
];
---
<Base title="News — Ulu Lāhui Foundation" description="Press releases and coverage about Ulu Lāhui Foundation.">
  <PageHead
    eyebrow="News"
    title="News & announcements"
    lede="Announcements, press releases, and media coverage — with the details and documents behind each."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/news/" />
  </div>

  <div class="seam-thick"></div>

  <div class="table">
    <div class="content-col">
      <div class="card-stack" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:24px;">
        {items.map((p) => (
          <a class="card-link" href={p.href}>
            <div class={`patch ${p.hue}`} style="padding:28px 26px; min-height:190px; display:flex; flex-direction:column; justify-content:flex-end;">
              <div class="label" style={p.head}>{p.date}</div>
              <h3 class={p.head} style="margin-top:6px; font-size:17px;">{p.title}</h3>
              <p style="font-size:13px; margin-top:8px; max-width:34ch;" class:list={p.head}>{p.text}</p>
              <span class="btn btn-tertiary" style="--tone:var(--alaea); padding-left:0; margin-top:14px;" class:list={p.head}>Read more</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="seam-thin"></div>

  <StitchedBand leftHue="olena" rightHue="kai" pair={2}>
    <div class="qb q-kai-l" style="padding:34px 40px;">
      <p style="font-size:14.5px;">
        Media inquiries: <a href={`${import.meta.env.BASE_URL}/support/contact/`} style="text-decoration:underline; text-decoration-style:dashed;">contact the foundation</a>.
      </p>
    </div>
  </StitchedBand>
</Base>