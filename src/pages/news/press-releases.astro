---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";

const tabs = [
  { label: "News", href: "/news/" },
  { label: "Press Releases", href: "/news/press-releases/" },
  { label: "Media Coverage", href: "/news/media-coverage/" },
  { label: "Newsletter", href: "/news/newsletter/" },
];

const releases = [
  {
    date: "May 2026",
    title: "AI for Hawaiʻi launches a sixth workshop season",
    body: [
      "ULF's AI for Hawaiʻi program completed its 2026 workshop season: six workshops, from the HI AI Summit launch to a talk story session in Hilo, reaching 33 schools and 6 complex areas.",
      "Every participating kumu left with ready-to-use lesson plans, resource hub access, ʻŌlelo Hawaiʻi AI terminology, and a classroom materials stipend. Pre/post measures showed a 97% average increase in AI understanding.",
    ],
    hue: "p-moana-l", head: "head-moana",
  },
  {
    date: "February 2026",
    title: "Kumu Connect evaluation published at IDC 2026",
    body: [
      "The flagship technical paper, Kumu Connect: Full System and Evaluation, was published at the 2026 Interaction Design and Children conference: 36 educators across 3 Kaiapuni schools, cultural accuracy of 4.20/5, and pedagogical usefulness of 4.45/5.",
      "The system was developed and evaluated with the support of fiscal sponsor Ulu HI-Tech under the aiEDU-funded project agreement.",
    ],
    hue: "p-alaea-l", head: "head-alaea",
  },
  {
    date: "2023",
    title: "ULF joins NSF-supported collaboration for place-based CS education",
    body: [
      "A multidisciplinary University of Hawaiʻi at Mānoa and Georgia Tech team received a five-year NSF award to broaden participation in computing. Ulu Lāhui Foundation participates in the collaboration as a support partner and subawardee for specific projects, including the PLACES Education curricula work.",
      "The award is held by the university team; we name it here for accuracy about who received it and what our role within it is.",
    ],
    hue: "p-ulu-l", head: "head-ulu-dark",
  },
];
---
<Base title="Press Releases — Ulu Lāhui Foundation" description="Dated press releases from Ulu Lāhui Foundation.">
  <PageHead
    eyebrow="News · Press Releases"
    title="Press releases"
    lede="Dated announcements, kept accurate about awards, roles, and relationships."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/news/press-releases/" />
  </div>

  <div class="table">
    <div class="content-col">
      <div class="card-stack" style="grid-template-columns:1fr; gap:26px;">
        {releases.map((r) => (
          <article class={`patch ${r.hue}`} style="padding:32px 34px;">
            <div class="label" class:list={r.head}>{r.date}</div>
            <h2 class={r.head} style="font-size:22px; margin:8px 0 14px;">{r.title}</h2>
            {r.body.map((p) => <p style="font-size:14.5px; margin-bottom:10px; max-width:60ch;">{p}</p>)}
          </article>
        ))}
      </div>
    </div>
  </div>
</Base>