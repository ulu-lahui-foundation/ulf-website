---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";
import { site } from "../../data/site";

const tabs = [
  { label: "Donate", href: `${BASE}/support/donate/` },
  { label: "Corporate Partnership", href: `${BASE}/support/corporate-partnership/` },
  { label: "Foundation Grants", href: `${BASE}/support/foundation-grant-partnership/` },
  { label: "Volunteer", href: `${BASE}/support/volunteer/` },
  { label: "Contact", href: `${BASE}/support/contact/` },
];

const uses = [
  { title: "Classroom materials stipends", text: "Every AI4HI kumu leaves with $50 for classroom materials. A gift keeps that promise." },
  { title: "Curricula in ʻŌlelo Hawaiʻi and English", text: "PLACES lessons, kumu professional development, and the Cultural Transposition Process with kumu and kūpuna." },
  { title: "Research with educators", text: "Co-design and evaluation are the reason our tools work; support keeps the evidence honest and ongoing." },
];
---
<Base title="Donate — Ulu Lāhui Foundation" description="Support Native Hawaiian capacity to create, use, and govern technology.">
  <PageHead
    eyebrow="Support · Donate"
    title="Give to the work"
    lede="Every dollar goes toward Native Hawaiian communities holding the knowledge, tools, and authority to create the technologies that shape their lives."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/support/donate/" />
  </div>

  <StitchedBand leftHue="alaea" rightHue="lehua" flip>
    <div class="callout p-kai">
      <svg class="callout-bg" viewBox="0 0 200 200" style="color:white;"><use href="#uluQuiltA" class="leaf" /></svg>
      <div class="content">
        <div class="eyebrow" style="color:var(--kai-light);">Donate</div>
        <h3>Make the future of Hawaiʻi a Hawaiian-made one</h3>
        <p>
          Secure online giving is being set up with a payment processor. Until then, the fastest way
          to give is to write to us, and we will bring you the rest of the way.
        </p>
        <a class="btn" style="background:var(--olena); color:var(--ink); border:1px dashed var(--olena-deep);" href={`mailto:${site.email}?subject=Giving to ULF`}>Arrange a gift</a>
      </div>
    </div>
  </StitchedBand>

  <div class="section container-narrow">
    <h2 style="margin-bottom:16px;">What a gift supports</h2>
    <div class="card-stack" style="grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:22px;">
      {uses.map((u, i) => (
        <div class={`patch ${i === 0 ? "p-alaea-l" : i === 1 ? "p-ulu-l" : "p-moana-l"}`} style="padding:26px 24px;">
          <h3 style={i === 0 ? "color:var(--alaea-deep); font-size:16px;" : i === 1 ? "color:var(--ulu-dark); font-size:16px;" : "color:var(--moana); font-size:16px;"}>{u.title}</h3>
          <p style="font-size:13.5px; margin-top:8px;">{u.text}</p>
        </div>
      ))}
    </div>
    <div style="text-align:center; margin-top:36px;">
      <a class="patch p-alaea" style="display:inline-block; padding:24px 30px; text-align:center;" aria-label="Ulu Lahui Foundation" href={site.candigProfile} target="_blank" rel="noopener">
        <img
          alt="Candid 2026 Platinum Seal of Transparency — Ulu Lāhui Foundation earned Candid's highest level of transparency recognition by publicly sharing information about our leadership, finances, programs, goals, and measurable impact."
          src={site.candidSeal}
          width="120"
          height="120"
        />
      </a>
      <p style="font-size:13px; color:var(--muted); margin-top:14px; max-width:52ch; margin-inline:auto;">
        {site.name} is a 501(c)(3), EIN {site.ein}. Contributions may be deductible to the extent
        allowed by law.
      </p>
    </div>
  </div>
</Base>