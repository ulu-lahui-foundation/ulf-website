---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";
import { site } from "../../data/site";

const tabs = [
  { label: "Donate", href: `${BASE}/support/donate/` },
  { label: "Corporate Partnership", href: `${BASE}/support/corporate-partnership/` },
  { label: "Foundation Grants", href: `${BASE}/support/foundation-grant-partnership/` },
  { label: "Volunteer", href: `${BASE}/support/volunteer/` },
  { label: "Contact", href: `${BASE}/support/contact/` },
];

const priorities = [
  { title: "Turning projects into durable programs", text: "Multi-year funding that lets Kumu Connect, AI for Hawaiʻi, and PLACES run on repeatable delivery models, not grant-to-grant." },
  { title: "Educator and kumu capacity", text: "Professional development, stipends, and materials that remove the cost barrier to classroom participation." },
  { title: "Research and evaluation", text: "The co-design, data collection, and publishing that keep our claims honest and our tools improving." },
];
---
<Base title="Foundation & Grant Partnership — Ulu Lāhui Foundation" description="For program officers: funding priorities, LOI process, and contact.">
  <PageHead
    eyebrow="Support · Foundation & Grant Partnership"
    title="Foundation & grant partnership"
    lede="For program officers doing diligence: what we prioritize, how we are governed, and how to start a conversation."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/support/foundation-grant-partnership/" />
  </div>

  <StitchedBand leftHue="moana" rightHue="kai" flip>
    <div class="piece-row">
      <div class="block pb p-moana-l">
        <div class="eyebrow" style="color:var(--moana);">Current funding priorities</div>
        <h3 style="color:var(--moana); margin-top:8px;">What we would fund next</h3>
        <ul style="list-style:none; margin-top:14px;">
          {priorities.map((p) => (
            <li style="margin-bottom:14px;">
              <strong style="font-size:14.5px;">{p.title}.</strong>
              <span style="font-size:13.5px;"> {p.text}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="block pb p-kai-l">
        <div class="eyebrow" style="color:var(--kai);">Before you write a check</div>
        <h3 style="color:var(--kai); margin-top:8px;">Diligence, served plainly</h3>
        <p style="margin-top:10px; font-size:13.5px;">
          Start with two pages: our <a href={`${import.meta.env.BASE_URL}/impact/`} style="text-decoration:underline; text-decoration-style:dashed;">impact</a>
          (sourced numbers) and our <a href={`${import.meta.env.BASE_URL}/about/#board`} style="text-decoration:underline; text-decoration-style:dashed;">board</a>
          (the governing board, on our about page). Then write to us.
        </p>
      </div>
    </div>
  </StitchedBand>

  <div class="section container-narrow">
    <div class="qb q-olena-l" style="padding:34px 40px;">
      <div class="eyebrow" style="color:var(--olena-dark);">LOI process</div>
      <h2 style="color:var(--olena-dark); margin-top:6px; font-size:22px;">One email, no portal</h2>
      <p style="margin-top:10px; font-size:14.5px;">
        Write a one-page letter of intent: who you are, what you fund, the size and term you are
        considering, and how our priorities match. We reply within two weeks, with either an
        invitation to talk or an honest no.
      </p>
      <a class="btn btn-primary" style="--tone:var(--olena); --tone-deep:var(--olena-deep); --tone-ink:var(--ink); margin-top:18px;" href={`mailto:${site.email}?subject=LOI — Foundation partnership`}>Send your letter of intent</a>
    </div>
  </div>
</Base>