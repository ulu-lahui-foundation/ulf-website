---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";
import { site } from "../../data/site";

const tabs = [
  { label: "Donate", href: `${BASE}/support/donate/` },
  { label: "Corporate Partnership", href: `${BASE}/support/corporate-partnership/` },
  { label: "Foundation Grants", href: `${BASE}/support/foundation-grant-partnership/` },
  { label: "Volunteer", href: `${BASE}/support/volunteer/` },
  { label: "Contact", href: `${BASE}/support/contact/` },
];

const routes = [
  { title: "General inquiries", text: "Program questions, press, speaking, and everything else.", to: "/support/contact/", local: true },
  { title: "Giving", text: "Individual gifts and donation logistics.", to: "/support/donate/" },
  { title: "Corporate and in-kind", text: "Devices, volunteers, and sponsorships.", to: "/support/corporate-partnership/" },
  { title: "Foundations and grants", text: "Letters of intent and program officer questions.", to: "/support/foundation-grant-partnership/" },
];
---
<Base title="Contact — Ulu Lāhui Foundation" description="Contact Ulu Lāhui Foundation.">
  <PageHead
    eyebrow="Support · Contact"
    title="Contact"
    lede="The right door for your question, so nothing waits on a wrong inbox."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/support/contact/" />
  </div>

  <div class="table">
    <div class="content-col">
      <div class="card-stack" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:22px;">
        {routes.map((r, i) => (
          <div class={`patch ${i === 0 ? "p-alaea-l" : i === 1 ? "p-ulu-l" : i === 2 ? "p-moana-l" : "p-kai-l"}`} style="padding:26px 24px;">
            <h3 style={i === 0 ? "color:var(--alaea-deep); font-size:16px;" : i === 1 ? "color:var(--ulu-dark); font-size:16px;" : i === 2 ? "color:var(--moana); font-size:16px;" : "color:var(--kai); font-size:16px;"}>{r.title}</h3>
            <p style="font-size:13.5px; margin-top:8px;">{r.text}</p>
            <a class="btn btn-tertiary" style="--tone:var(--alaea); padding-left:0; margin-top:8px;" href={r.to}>That way</a>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="seam-thin"></div>

  <StitchedBand leftHue="kai" rightHue="moana" pair={3}>
    <div class="p-kai" style="padding:40px 44px; color:white;">
      <div style="max-width:48ch;">
        <div class="eyebrow" style="color:var(--kai-light);">Email, simplest</div>
        <h2 style="margin-top:6px; color:white;">We read everything</h2>
        <p style="margin-top:14px; color:rgba(255,255,255,0.9);">
          <a href={`mailto:${site.email}`} style="color:var(--kai-light); font-weight:700; font-size:18px;">{site.email}</a>
          <br />
          We answer within a week, and usually much faster for partners already in conversation.
        </p>
      </div>
    </div>
  </StitchedBand>
</Base>