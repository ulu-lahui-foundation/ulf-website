---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";
import { site } from "../../data/site";

const tabs = [
  { label: "Overview", href: "/partners/" },
  { label: "Funders", href: "/partners/funders/" },
  { label: "Schools & Communities", href: "/partners/schools-communities/" },
  { label: "Become a Partner", href: "/partners/become-a-partner/" },
];

const ways = [
  { title: "Bring PLACES Education to your school", text: "Place-based CS lessons in ʻŌlelo Hawaiʻi and English, ʻāina-based projects, and quarterly professional development for your kumu.", hue: "p-ulu-l", head: "head-ulu-dark" },
  { title: "Adopt Kumu Connect", text: "Kaiapuni schools and complex areas can pilot the AI system built and evaluated for Hawaiian immersion classrooms.", hue: "p-alaea-l", head: "head-alaea" },
  { title: "Host an AI for Hawaiʻi workshop", text: "Districts, community centers, and nonprofits can bring the workshop series to their educators and families.", hue: "p-moana-l", head: "head-moana" },
  { title: "Co-design with us", text: "Organizations working with Native Hawaiian communities can join the research practice: co-design, evaluation, and publication.", hue: "p-kai-l", head: "head-kai" },
];
---
<Base title="Become a Partner — Ulu Lāhui Foundation" description="Bring PLACES Education, Kumu Connect, or AI for Hawaiʻi to your school, district, or community.">
  <PageHead
    eyebrow="Partners · Become a Partner"
    title="Become a partner"
    lede="For schools, districts, and other nonprofits who want to bring our programs to their community."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/partners/become-a-partner/" />
  </div>

  <div class="seam-thick"></div>

  <div class="table">
    <div class="content-col">
      <div class="band-label">
        <div class="eyebrow">Ways to work together</div>
        <h2 style="margin-top:8px;">Programs that travel well</h2>
      </div>
      <div class="gallery">
        {ways.map((w, i) => (
          <div class={`cell patch ${w.hue} ${i % 3 === 1 ? "tilt-b" : ""}`} style="aspect-ratio:auto; min-height:170px;">
            <div class="lbl" class:list={w.head}>{w.title}</div>
            <div class="sub-lbl" style="font-weight:400; text-transform:none; letter-spacing:0; opacity:1; margin-top:6px;">{w.text}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="seam-thin"></div>

  <StitchedBand leftHue="kai" rightHue="olena" flip>
    <div class="p-kai" style="padding:40px 44px; color:white;">
      <div style="max-width:52ch;">
        <div class="eyebrow" style="color:var(--kai-light);">How it starts</div>
        <h2 style="margin-top:6px; color:white;">A conversation, then a pilot</h2>
        <p style="margin-top:14px; color:rgba(255,255,255,0.9);">
          Reach us at <a href={`mailto:${site.email}`} style="color:var(--kai-light); font-weight:700;">{site.email}</a>
          with a sentence about your school, district, or community, and what you are trying to
          accomplish. We begin with talk story: what you hold, what you need, and whether one of our
          programs fits, and we are honest when the answer is not yet.
        </p>
      </div>
    </div>
  </StitchedBand>
</Base>