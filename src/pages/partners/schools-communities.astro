---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";
import { schoolsByIsland } from "../../data/partners";

const tabs = [
  { label: "Overview", href: `${BASE}/partners/` },
  { label: "Funders", href: `${BASE}/partners/funders/` },
  { label: "Schools & Communities", href: `${BASE}/partners/schools-communities/` },
  { label: "Become a Partner", href: `${BASE}/partners/become-a-partner/` },
];
---
<Base title="Schools & Communities — Ulu Lāhui Foundation" description="The schools and communities ULF serves, by island and complex area.">
  <PageHead
    eyebrow="Partners · Schools & Communities"
    title="Schools & communities, by island"
    lede="Every entry below is a place where our work actually runs: a classroom, a complex area, a community."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/partners/schools-communities/" />
  </div>

  <StitchedBand leftHue="ulu" rightHue="moana" pair={2}>
    <div class="piece-row">
      {schoolsByIsland.map((is, i) => (
        <div class={`block pb ${i === 0 ? "p-ulu-l" : i === 1 ? "p-alaea-l" : "p-moana-l"}`}>
          <div class="eyebrow" style={i === 0 ? "color:var(--ulu-dark);" : i === 1 ? "color:var(--alaea-deep);" : "color:var(--moana);"}>Island</div>
          <h3 style={i === 0 ? "color:var(--ulu-dark); margin-top:6px;" : i === 1 ? "color:var(--alaea-deep); margin-top:6px;" : "color:var(--moana); margin-top:6px;"}>{is.island}</h3>
          <ul style="list-style:none; margin-top:12px;">
            {is.areas.map((a) => (
              <li style="font-size:13.5px; margin-bottom:8px;">{a}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </StitchedBand>

  <div class="section container-narrow">
    <div class="qb q-kai-l" style="padding:30px 36px;">
      <p style="font-size:14.5px;">
        Plus: communities in Kāneʻohe (Oʻahu), Hāna (Maui), and Niʻihau partner with PLACES
        Education, and the AI for Hawaiʻi workshops reached schools across 6 complex areas in 2026.
        This list grows with the programs.
      </p>
    </div>
    <p style="font-size:13px; color:var(--muted); margin-top:20px;">
      A map of schools and complex areas is on the way; in the meantime this island-by-island list
      does the same job.
    </p>
  </div>
</Base>