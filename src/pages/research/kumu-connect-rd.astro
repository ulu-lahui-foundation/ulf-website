---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";

const tabs = [
  { label: "Overview", href: `${BASE}/research/` },
  { label: "Publications", href: `${BASE}/research/publications/` },
  { label: "Kumu Connect R&D", href: `${BASE}/research/kumu-connect-rd/` },
  { label: "Data Sovereignty & AI", href: `${BASE}/research/indigenous-data-sovereignty/` },
  { label: "Collaborators", href: `${BASE}/research/collaborators/` },
];

const pipeline = [
  { step: "01", title: "Constrained generation", text: "The system generates within carefully defined guardrails so output stays culturally grounded and linguistically correct." },
  { step: "02", title: "Reflective verification", text: "A verification pass checks the result against the curated Hawaiian cultural corpus before anything reaches a kumu." },
  { step: "03", title: "Lesson synthesis", text: "Verified content is composed into complete, ready-to-use lesson plans with cultural accuracy at the center." },
];

const imaginaries = [
  { title: "Ahupuaʻa-organized data structures", text: "Organizing data by the land itself: watershed-bounded data organization rather than platform-shaped defaults." },
  { title: "Data sovereignty as a usability principle", text: "Ownership and governance of data as a feature users can feel, not a policy buried in fine print." },
  { title: "Cultural-proximity-aware personas", text: "Interfaces that understand cultural context and closeness, not just language and clicks." },
  { title: "Kumu-style incremental knowledge sharing", text: "Teaching patterns where knowledge is shared the way a kumu shares it: with guidance, in context, over time." },
];
---
<Base title="Kumu Connect R&D — Ulu Lāhui Foundation" description="The architecture, evaluation, and future imaginaries behind Kumu Connect.">
  <PageHead
    eyebrow="Research · Kumu Connect R&D"
    title="Kumu Connect: the system under the product"
    lede="Model- and architecture-specific detail lives here, so the product page stays evergreen."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/research/kumu-connect-rd/" />
  </div>

  <StitchedBand leftHue="alaea" rightHue="kai" pair={2}>
    <div class="p-alaea" style="padding:44px 46px; color:white;">
      <div style="max-width:60ch;">
        <div class="eyebrow" style="color:var(--olena-light);">The evaluated architecture</div>
        <p style="margin-top:12px; font-size:16px; font-weight:600; color:white;">
          The system evaluated in the 2025–2026 study used Claude 3.7 Sonnet with
          retrieval-augmented generation over a curated Hawaiian cultural corpus.
        </p>
      </div>
    </div>
  </StitchedBand>

  <div class="section container-narrow">
    <h2 style="margin-bottom:18px;">The three-phase pipeline</h2>
    <div class="card-stack" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:22px;">
      {pipeline.map((p, i) => (
        <div class={`patch ${i === 0 ? "p-moana-l" : i === 1 ? "p-kai-l tilt-b" : "p-lehua-l"}`} style="padding:26px 24px;">
          <div class="num" style={i === 0 ? "color:var(--moana); font-size:20px;" : i === 1 ? "color:var(--kai); font-size:20px;" : "color:var(--lehua); font-size:20px;"}>{p.step}</div>
          <h3 class:list={i === 0 ? "head-moana" : i === 1 ? "head-kai" : "head-lehua"} style="font-size:16px; margin-top:6px;">{p.title}</h3>
          <p style="font-size:13px; margin-top:8px;">{p.text}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="seam-thick"></div>

  <div class="table">
    <div class="content-col">
      <div class="band-label bl-moana">
        <div class="eyebrow">Forward research</div>
        <h2 style="margin-top:8px;">Four future imaginaries for Indigenous AI</h2>
      </div>
      <div class="gallery">
        {imaginaries.map((im, i) => (
          <div class={`cell patch ${i % 2 === 0 ? "p-ulu-l" : "p-olena-l"}`} style="aspect-ratio:auto; min-height:190px;">
            <div class="lbl" style={i % 2 === 0 ? "color:var(--ulu-dark);" : "color:var(--olena-dark);"}>{im.title}</div>
            <div class="sub-lbl" style="font-weight:400; text-transform:none; letter-spacing:0; opacity:1; margin-top:6px;">{im.text}</div>
          </div>
        ))}
      </div>
      <p style="font-size:12.5px; color:var(--muted); margin-top:20px;">
        When the underlying model changes in a future version, only this page needs updating; the
        product page copy does not reference a specific model.
      </p>
    </div>
  </div>
</Base>