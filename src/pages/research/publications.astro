---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";
import { publications, type PubRelation } from "../../data/publications";

const tabs = [
  { label: "Overview", href: `${BASE}/research/` },
  { label: "Publications", href: `${BASE}/research/publications/` },
  { label: "Kumu Connect R&D", href: `${BASE}/research/kumu-connect-rd/` },
  { label: "Data Sovereignty & AI", href: `${BASE}/research/indigenous-data-sovereignty/` },
  { label: "Collaborators", href: `${BASE}/research/collaborators/` },
];

const relations: (PubRelation | "all")[] = [
  "all",
  "ULF-led",
  "ULF program evaluated",
  "ULF collaborator",
  "foundational research",
  "related research",
];

const relationTone: Record<PubRelation, string> = {
  "ULF-led": "chip-alaea",
  "ULF program evaluated": "chip-kai",
  "ULF collaborator": "chip-moana",
  "foundational research": "chip-ulu",
  "related research": "chip-olena",
};

const cardTones = ["p-moana-l", "p-kai-l", "p-alaea-l", "p-lehua-l", "p-ulu-l"];
const headTones = ["head-moana", "head-kai", "head-alaea", "head-lehua", "head-ulu-dark"];
---
<Base title="Publications — Ulu Lāhui Foundation" description="Seven papers, each tagged with ULF's precise relationship to the work.">
  <PageHead
    eyebrow="Research · Publications"
    title="Publications"
    lede="A real, citable list. Each entry names ULF's actual relationship to the work, so a program officer never has to wonder whether a paper is ULF research, a ULF program evaluated by academic researchers, or related research we are simply citing."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/research/publications/" />
  </div>

  <div class="container" style="margin-top:18px;">
    <div class="filters" id="pub-filters" role="group" aria-label="Filter publications">
      {relations.map((r) => (
        <button class:list={["tag-pill", r === "all" && "active"]} data-filter={r === "all" ? "" : r} type="button">
          {r === "all" ? "All" : r}
        </button>
      ))}
    </div>
  </div>

  <div class="table">
    <div class="content-col">
      <div class="gallery-st" id="pub-grid">
        {publications.map((pub, i) => (
          <article class={`cell pb ${cardTones[i % cardTones.length]}`} data-rel={pub.relation} style="aspect-ratio:auto; min-height:230px; overflow:hidden;">
            <svg class="leaf-bg" viewBox="0 0 200 189" style={`position:absolute; right:-20px; bottom:-20px; width:120px; height:114px; opacity:0.45; z-index:0; color:${i % 2 === 0 ? "var(--moana-light-deep)" : "var(--kai-light-deep)"};`}><use href="#uluLeaf" class="leaf" /></svg>
            <div style="position:relative; z-index:1;">
              <div class="lbl" class:list={headTones[i % headTones.length]} style="font-size:15px; line-height:1.3;">{pub.title}</div>
              <div class="label" style="margin-top:8px; color:var(--muted);">{pub.venue} · {pub.year}</div>
              <span class={`chip ${relationTone[pub.relation]}`} style="margin-top:12px;">{pub.relation}</span>
              <p style="font-size:13px; margin-top:12px; max-width:40ch;">{pub.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div class="container" style="margin-top:20px;">
    <p style="font-size:13px; color:var(--muted);">
      Author lists and public links will be added as they are confirmed for publication. Every paper
      appears at its venue; several were presented with the Ka Moamoa Lab at Georgia Tech, ULF's
      research collaborator.
    </p>
  </div>

  <script>
    const pills = Array.from(document.querySelectorAll<HTMLButtonElement>("#pub-filters .tag-pill"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#pub-grid article"));
    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        pills.forEach((p) => p.classList.toggle("active", p === pill));
        const filter = pill.dataset.filter ?? "";
        cards.forEach((card) => {
          const show = filter === "" || card.dataset.rel === filter;
          card.style.display = show ? "" : "none";
        });
      });
    });
  </script>
</Base>