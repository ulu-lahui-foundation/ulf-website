---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";

const tabs = [
  { label: "Initiatives Overview", href: `${BASE}/initiatives/` },
  { label: "PLACES Education", href: `${BASE}/initiatives/places-education/` },
  { label: "Kumu Connect", href: `${BASE}/initiatives/kumu-connect/` },
  { label: "AI for Hawaiʻi", href: `${BASE}/initiatives/ai-for-hawaii/` },
  { label: "Community & Workforce", href: `${BASE}/initiatives/community-workforce/` },
];

const deliverables = [
  "Computer Science lessons, K-12, standards-aligned in ʻŌlelo Hawaiʻi and English",
  "Computer literacy lessons and ʻāina-based projects",
  "The Cultural Transposition Process, working with kumu and kūpuna",
  "Ongoing PLACES point-of-contact support for partner schools",
  "Quarterly professional development sessions",
  "Access to the PLACES resource database",
];
---
<Base title="PLACES Education — Ulu Lāhui Foundation" description="PLACES Education advances place-based and culturally revitalizing educational opportunities.">
  <PageHead
    eyebrow="Initiatives · PLACES Education"
    title="PLACES Education"
    lede="Place-based and culturally revitalizing CS and STEM, centered on community engagement and co-design."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/initiatives/places-education/" />
  </div>

  <StitchedBand leftHue="ulu" rightHue="moana" pair={4}>
    <div class="p-ulu-l" style="padding:44px 46px;">
      <blockquote style="font-size:17px; font-weight:600; color:var(--ulu-dark); max-width:58ch;">
        PLACES Education advances place-based and culturally revitalizing educational opportunities
        through professional development, innovative curricula, and infrastructure, resources, and AI
        productivity tools — centered on community engagement and co-design, with priority on
        Indigenous language support, community-based projects, and environmental stewardship.
      </blockquote>
    </div>
  </StitchedBand>

  <div class="section container-narrow">
    <h2 style="color:var(--ulu-dark); margin-bottom:16px;">What kumu and schools receive</h2>
    <div class="card-stack" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px;">
      {deliverables.map((d, i) => (
        <div class={`patch ${i % 2 === 0 ? "p-ulu-l" : "p-moana-l"}`} style="padding:20px 22px;">
          <svg viewBox="0 0 200 189" style={`width:22px; height:21px; ${i % 2 === 0 ? "color:var(--ulu-deep);" : "color:var(--moana);"}`}><use href="#uluLeaf" class="leaf-outline" /></svg>
          <p style="font-size:14px; margin-top:8px;">{d}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="seam-thin"></div>

  <StitchedBand leftHue="olena-l" rightHue="kai" pair={5}>
    <div class="piece-row">
      <div class="block pb p-moana-l">
        <div class="eyebrow" style="color:var(--moana);">Where it started</div>
        <h3 style="color:var(--moana); margin-top:8px;">Mālama ʻĀina through Micro:bits</h3>
        <p style="margin-top:10px;">
          The program grew from solar-powered micro:bit water-quality sensors at Waikalua Loko Iʻa
          fishpond, built with Puʻōhala School and the Pacific American Foundation. Place came first;
          the computer science followed.
        </p>
      </div>
      <div class="block pb p-kai-l">
        <div class="eyebrow" style="color:var(--kai);">Where it runs</div>
        <h3 style="color:var(--kai); margin-top:8px;">Supported by NSF, rooted in community</h3>
        <p style="margin-top:10px;">
          PLACES is supported through a five-year National Science Foundation award with the University
          of Hawaiʻi at Mānoa and Georgia Tech. Partner school communities include Kāneʻohe on Oʻahu,
          Hāna on Maui, and Niʻihau.
        </p>
      </div>
    </div>
  </StitchedBand>
</Base>