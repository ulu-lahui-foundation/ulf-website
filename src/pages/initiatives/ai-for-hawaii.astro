---
import { BASE } from "../../lib/base";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import StitchedBand from "../../components/StitchedBand.astro";
import SectionTabs from "../../components/SectionTabs.astro";

const tabs = [
  { label: "Initiatives Overview", href: `${BASE}/initiatives/` },
  { label: "PLACES Education", href: `${BASE}/initiatives/places-education/` },
  { label: "Kumu Connect", href: `${BASE}/initiatives/kumu-connect/` },
  { label: "AI for Hawaiʻi", href: `${BASE}/initiatives/ai-for-hawaii/` },
  { label: "Community & Workforce", href: `${BASE}/initiatives/community-workforce/` },
];

const themes = [
  "Cultural alignment",
  "Data sovereignty",
  "Sustainable models",
  "Language & translation",
  "Low-connectivity AI",
  "Creative expression",
];

const outcomes = [
  { num: "97%", label: "Average increase in AI understanding", sub: "126% among initially low-confidence participants" },
  { num: "4.6/5", label: "Workshop usefulness" },
  { num: "4.7/5", label: "Resource hub usefulness" },
  { num: "84%", label: "Of teachers could deliver their lesson as-is or with minor changes" },
];
---
<Base title="AI for Hawaiʻi — Ulu Lāhui Foundation" description="AI for Hawaiʻi workshops put AI literacy, data sovereignty, and language tools in the hands of educators.">
  <PageHead
    eyebrow="Initiatives · AI for Hawaiʻi"
    title="AI for Hawaiʻi"
    lede="The program with the hardest numbers: six workshops, 33 schools, and measurable growth in AI understanding among kumu."
  />
  <div class="container" style="margin-top:6px;">
    <SectionTabs links={tabs} current="/initiatives/ai-for-hawaii/" />
  </div>

  <StitchedBand leftHue="moana" rightHue="olena" pair={1}>
    <div class="p-moana-l" style="padding:44px 46px;">
      <div style="max-width:60ch;">
        <div class="eyebrow" style="color:var(--moana);">The workshops</div>
        <p style="margin-top:12px; font-size:15.5px;">
          Six workshops delivered: a launch at the HI AI Summit, two online ʻŌlelo Hawaiʻi sessions,
          two online English sessions, and one in-person ʻŌlelo Hawaiʻi talk story session in Hilo.
          Every participating kumu leaves with ready-to-use lesson plans, access to the resource hub,
          ʻŌlelo Hawaiʻi AI terminology, and a \$50 classroom materials stipend.
        </p>
      </div>
    </div>
  </StitchedBand>

  <div class="section container-narrow">
    <h2 style="margin-bottom:16px;">Workshop themes</h2>
    <div style="display:flex; gap:12px; flex-wrap:wrap;">
      {themes.map((t) => <span class="chip chip-moana">{t}</span>)}
    </div>
  </div>

  <div class="seam-thick"></div>

  <div class="table">
    <div class="content-col">
      <div class="band-label">
        <div class="eyebrow">Outcomes — AI4HI 2026 Impact Report</div>
        <h2 style="margin-top:8px;">Measured, not promised</h2>
      </div>
      <div class="gallery">
        {outcomes.map((o, i) => (
          <div class={`cell patch ${i % 2 === 0 ? "p-moana-l" : "p-kai-l"}`} style="aspect-ratio:auto; min-height:150px;">
            <div class="num" style={i % 2 === 0 ? "color:var(--moana);" : "color:var(--kai);"}>{o.num}</div>
            <div class="lbl" style={i % 2 === 0 ? "color:var(--moana); margin-top:2px;" : "color:var(--kai); margin-top:2px;"}>{o.label}</div>
            {o.sub && <p style="font-size:12.5px; margin-top:8px; color:var(--ink);">{o.sub}</p>}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="seam-thin"></div>

  <StitchedBand leftHue="lehua" rightHue="kai" pair={2}>
    <div class="qb q-kai-l" style="padding:36px 42px;">
      <div class="eyebrow" style="color:var(--kai);">Reach</div>
      <p style="margin-top:10px; font-size:15px;">
        The 2026 workshops reached 33 schools and 6 complex areas across the islands, and launched
        participating kumu into the AI4HI Resource Hub, which continues to offer lessons, ʻŌlelo
        Hawaiʻi AI terminology, and community.
      </p>
    </div>
  </StitchedBand>
</Base>