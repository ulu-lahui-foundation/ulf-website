---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---
<div class="page-head container-narrow">
  <div class="eyebrow">{eyebrow}</div>
  <h1 style="margin-top:12px;">{title}</h1>
  {lede && <p class="lede" style="margin-top:14px;">{lede}</p>}
</div>