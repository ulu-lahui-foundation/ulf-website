---
// A pieced, stitched section: two quilted gutters + center content.
// Gutter art: Quilt_LeftGutter_N / Quilt_RightGutter_N paired by `pair`,
// rotated through the six options site-wide (design guide Part 2a).
import { BASE } from "../lib/base";
interface Props {
  leftHue?: string; // e.g. "lehua" | "lehua-l" (gutter fill hue)
  rightHue?: string;
  pair?: number; // quilt pair 1–6 (left + right art share the same N)
  ariaHidden?: boolean;
}
const { leftHue = "lehua", rightHue = "moana", pair = 1, ariaHidden = false } = Astro.props;
const n = ((pair - 1) % 6 + 6) % 6 + 1;
---
<div class="stitched" aria-hidden={ariaHidden}>
  <div class="page-frame">
    <div class={`page-gutter pb p-${leftHue} gutter-l`}>
      <img src={`${BASE}/media/quilt/Quilt_LeftGutter_${n}.avif`} alt="" width="480" height="160" loading="lazy" />
    </div>
    <div class="page-frame-content">
      <slot />
    </div>
    <div class={`page-gutter pb p-${rightHue} gutter-r`}>
      <img src={`${BASE}/media/quilt/Quilt_RightGutter_${n}.avif`} alt="" width="480" height="160" loading="lazy" />
    </div>
  </div>
</div>