---
import { BASE } from "../lib/base";
const path = Astro.url.pathname;
const items = [
  { label: "Home", href: `${BASE}` },
  { label: "About", href: `${BASE}/about/` },
  {
    label: "Initiatives", href: `${BASE}/initiatives/`, children: [
      { label: "Initiatives Overview", href: `${BASE}/initiatives/` },
      { label: "PLACES Education", href: `${BASE}/initiatives/places-education/` },
      { label: "Kumu Connect", href: `${BASE}/initiatives/kumu-connect/` },
      { label: "AI for Hawaiʻi", href: `${BASE}/initiatives/ai-for-hawaii/` },
      { label: "Community & Workforce", href: `${BASE}/initiatives/community-workforce/` },
    ],
  },
  {
    label: "Impact", href: `${BASE}/impact/`, children: [
      { label: "At a Glance", href: `${BASE}/impact/` },
      { label: "By Program", href: `${BASE}/impact/by-program/` },
      { label: "Stories", href: `${BASE}/impact/stories/` },
    ],
  },
  {
    label: "Research", href: `${BASE}/research/`, children: [
      { label: "Overview", href: `${BASE}/research/` },
      { label: "Publications", href: `${BASE}/research/publications/` },
      { label: "Kumu Connect R&D", href: `${BASE}/research/kumu-connect-rd/` },
      { label: "Data Sovereignty & AI", href: `${BASE}/research/indigenous-data-sovereignty/` },
      { label: "Collaborators", href: `${BASE}/research/collaborators/` },
    ],
  },
  {
    label: "Partners", href: `${BASE}/partners/`, children: [
      { label: "Overview", href: `${BASE}/partners/` },
      { label: "Funders", href: `${BASE}/partners/funders/` },
      { label: "Schools & Communities", href: `${BASE}/partners/schools-communities/` },
      { label: "Become a Partner", href: `${BASE}/partners/become-a-partner/` },
    ],
  },
  {
    label: "News", href: `${BASE}/news/`, children: [
      { label: "News", href: `${BASE}/news/` },
      { label: "Press Releases", href: `${BASE}/news/press-releases/` },
      { label: "Media Coverage", href: `${BASE}/news/media-coverage/` },
      { label: "Newsletter", href: `${BASE}/news/newsletter/` },
    ],
    edge: true,
  },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---
<nav class="site-nav" id="site-nav" aria-label="Primary">
  <div class="site-nav-inner">
    <a class="brand" href={`${import.meta.env.BASE_URL}`}>
      <svg viewBox="0 0 200 189" aria-hidden="true"><use href="#uluLeaf" class="leaf" /></svg>
      <span>
        Ulu Lāhui
        <small>Foundation</small>
      </span>
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-links">
      Menu
    </button>
    <div class="nav-links" id="nav-links">
      {items.map((item) =>
        "children" in item && item.children ? (
          <div class:list={["nav-group", item.edge && "nav-edge"]}>
            <a href={item.href} class:list={isActive(item.href) && "active"} aria-haspopup="true" aria-expanded="false">
              {item.label}
              <svg class="caret" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            </a>
            <div class="nav-sub">
              {item.children.map((child) => (
                <a href={child.href} class:list={isActive(child.href) && "active"}>{child.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={isActive(item.href) && "active"}>{item.label}</a>
        )
      )}
      <a class="nav-cta" href={`${import.meta.env.BASE_URL}/support/donate/`}>Donate</a>
    </div>
  </div>
</nav>
<script>
  const btn = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");
  btn?.addEventListener("click", () => {
    const open = nav?.classList.toggle("menu-open");
    btn.setAttribute("aria-expanded", String(open));
  });
  document.querySelectorAll<HTMLElement>(".nav-group").forEach((group) => {
    const link = group.querySelector<HTMLAnchorElement>(":scope > a");
    link?.addEventListener("mouseenter", () => link.setAttribute("aria-expanded", "true"));
    link?.addEventListener("mouseleave", () => link.setAttribute("aria-expanded", "false"));
    group.addEventListener("focusout", (e) => {
      if (!group.contains(e.relatedTarget as Node)) {
        link?.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>